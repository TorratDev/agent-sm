{
  "provider": "pi",
  "format": "cargo fmt --all",
  "checks": [
    "cargo fmt --all -- --check",
    "cargo clippy --workspace --all-targets -- -D warnings",
    "cargo test --workspace",
    "cargo test --workspace --doc"
  ],
  "base_checks": [
    "cargo fmt --all -- --check",
    "cargo clippy --workspace --all-targets -- -D warnings"
  ],
  "links": ["pmdb.nds"],
  "commands": {
    "execute": ["cargo fmt", "cargo check", "cargo clippy", "cargo build", "cargo test"]
  }
}
